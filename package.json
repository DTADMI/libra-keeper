{
  "name": "libra-keeper",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "overrides": {
      "mime": "^3.0.0",
      "glob-parent": "^6.0.2",
      "json5": "^2.2.3",
      "yargs-parser": "^21.1.1",
      "node-forge": "^1.3.1",
      "serialize-javascript": ">=7.0.3",
      "@hono/node-server": ">=1.19.13"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "typecheck": "pnpm exec prisma generate && tsc --noEmit",
    "dev": "next dev --webpack",
    "build": "pnpm exec prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:ci": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:init": "pnpm exec prisma migrate dev --name init",
    "setup:local": "node scripts/setup-local.js",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:stop": "docker compose -f docker-compose.local.yml stop",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "dev:local": "pnpm docker:up && pnpm supabase:start && pnpm dev",
    "check:supabase-security": "node scripts/check-supabase-security.mjs",
    "run-all-checks": "pnpm lint:ci && pnpm typecheck && pnpm test && pnpm check:supabase-security && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.2",
